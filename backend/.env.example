# MongoDB Atlas Connection String
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/parent_teacher_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Server Environment
PORT=5000
NODE_ENV=production

# Frontend Client URL for CORS (e.g., your Vercel frontend URL)
CLIENT_URL=https://your-frontend-app.vercel.app
