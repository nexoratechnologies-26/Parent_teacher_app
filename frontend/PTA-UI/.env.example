# Backend API Base URL (Relative /api/v1 when deployed together on Vercel)
EXPO_PUBLIC_API_URL=/api/v1

# Supabase Authentication & Database (Optional - add your project keys from supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mock Data Mode (set to 'false' for live backend/supabase, 'true' for offline testing)
EXPO_PUBLIC_USE_MOCK=false
